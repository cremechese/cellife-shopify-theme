{{ 'section-cellife-product-finder.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'cellife-product-finder.js' | asset_url }}"></script>
{%- liquid
  assign finder_mode = 'public'
  assign finder_heading_tag = 'h2'
  if template.suffix == 'product-finder'
    assign finder_heading_tag = 'h1'
  endif
  if theme.role == 'unpublished' or request.design_mode
    assign finder_mode = 'draft'
  endif
  assign finder_ids = 'stress,propolis,man,sugar,bq,rrr,coq10,detox,boost,vision,ampk,antioxidant' | split: ','
-%}
<cellife-product-finder class="cellife-finder" data-instance="{{ section.id }}" style="--finder-background: {{ section.settings.background }}; --finder-accent: {{ section.settings.accent }}; --finder-width: {{ section.settings.content_width }}px;">
  <div class="cellife-finder__inner">
    <header class="cellife-finder__header">
      {% if section.settings.eyebrow != blank %}<p class="cellife-finder__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <{{ finder_heading_tag }}>{{ section.settings.heading | escape }}</{{ finder_heading_tag }}>
      {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
    </header>
    <p class="cellife-finder__draft">Draft — product claims and labels awaiting review.</p>
    <p class="cellife-finder__boundary">Find a Cellife product to explore for your wellbeing goal. Your answers match product-sheet information; they do not establish that a product is effective or safe for you. You can receive a no-match result. This is not a diagnosis or treatment plan.</p>
    <p class="cellife-finder__privacy">Your answers stay in this page’s memory and clear when you restart or leave. No email is required. Avoid sharing this screen while answering.</p>
    <div data-finder-stage>
      {% if finder_mode == 'draft' %}
        <p data-finder-loading role="status">Loading the draft product finder…</p>
      {% else %}
        <div class="cellife-finder__panel"><h3 class="cellife-finder__result-title">This finder is awaiting review</h3><p>No product can be suggested until current labels, claims and product destinations are reviewed. This draft cannot run on the published theme.</p></div>
      {% endif %}
    </div>
    <noscript><p>This finder needs JavaScript. A pharmacist or healthcare professional can help you review suitable options.</p></noscript>
    {% if request.design_mode %}
      <details class="cellife-finder__evidence" data-finder-evidence><summary>Staff preview: evidence and rule references</summary><div data-finder-evidence-content>Complete a draft route to inspect its rule and evidence references. Answers are not logged.</div></details>
    {% endif %}
  </div>
  {%- capture finder_config -%}
  {
    "mode": {{ finder_mode | json }},
    "engineUrl": {% if finder_mode == 'draft' %}{{ 'cellife-finder-engine.js' | asset_url | json }}{% else %}null{% endif %},
    "dataUrl": {% if finder_mode == 'draft' %}{{ 'cellife-finder-data.js' | asset_url | json }}{% else %}null{% endif %},
    "startLabel": {{ section.settings.start_label | json }},
    "mappings": {
      {%- for finder_id in finder_ids -%}
        {%- assign setting_id = 'product_' | append: finder_id -%}
        {%- assign finder_product = section.settings[setting_id] -%}
        {{ finder_id | json }}:
        {%- if finder_product != blank -%}
          {"id": {{ finder_product.id | append: '' | json }}, "title": {{ finder_product.title | json }}, "url": {{ finder_product.url | json }}, "image": {% if finder_product.featured_image != blank %}{{ finder_product.featured_image | image_url: width: 480 | json }}{% else %}null{% endif %}, "price": {{ finder_product.price | money_with_currency | json }}}
        {%- else -%}null{%- endif -%}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  }
  {%- endcapture -%}
  <script type="application/json" data-finder-config>{{ finder_config | replace: '<', '\u003c' }}</script>
</cellife-product-finder>

{% schema %}
{
  "name": "Cellife Product Finder",
  "tag": "section",
  "class": "cellife-finder-section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIND YOUR STARTING POINT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the Cellife range."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introductory text",
      "default": "<p>A few questions to help you find product information for one wellbeing goal.</p>"
    },
    {
      "type": "text",
      "id": "start_label",
      "label": "Start button",
      "default": "Start the product finder"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f4f3f2"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Heading and button colour",
      "default": "#3e2b62"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Maximum content width",
      "min": 640,
      "max": 1120,
      "step": 40,
      "unit": "px",
      "default": 880
    },
    {
      "type": "header",
      "content": "Catalogue product connections"
    },
    {
      "type": "paragraph",
      "content": "Connect each stable quiz ID to its exact Shopify product. Mapping does not approve claims or current labels. Missing destinations are held; excluded products are never replaced by a commercial fallback."
    },
    {
      "type": "product",
      "id": "product_stress",
      "label": "Stress Relief (stress)"
    },
    {
      "type": "product",
      "id": "product_propolis",
      "label": "Royal Jelly (propolis ID; source hold)"
    },
    {
      "type": "product",
      "id": "product_man",
      "label": "Man Power (man)"
    },
    {
      "type": "product",
      "id": "product_sugar",
      "label": "Sugar Support (sugar)"
    },
    {
      "type": "product",
      "id": "product_bq",
      "label": "Bromelains & Quercetin (bq)"
    },
    {
      "type": "product",
      "id": "product_rrr",
      "label": "R.R.R. (rrr)"
    },
    {
      "type": "product",
      "id": "product_coq10",
      "label": "CoQ10 (coq10)"
    },
    {
      "type": "product",
      "id": "product_detox",
      "label": "Detox (detox)"
    },
    {
      "type": "product",
      "id": "product_boost",
      "label": "R.R.R. Boost (boost)"
    },
    {
      "type": "product",
      "id": "product_vision",
      "label": "Vision+ (vision)"
    },
    {
      "type": "product",
      "id": "product_ampk",
      "label": "AMPK Fatburst (ampk)"
    },
    {
      "type": "product",
      "id": "product_antioxidant",
      "label": "Antioxidant (antioxidant)"
    }
  ],
  "presets": [
    {
      "name": "Cellife Product Finder"
    }
  ]
}
{% endschema %}
