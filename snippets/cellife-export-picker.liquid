<cellife-export-picker class="cellife-export-picker">
  <p class="cellife-export-label">Export enquiry only</p>
  <p>These products are available for export only and cannot be purchased within Australia. Please submit your enquiry and our team will contact you with availability, pricing, and shipping information.</p>
  <p>Catalogue prices are for reference. No payment is collected for an enquiry.</p>
  <label>Variant
    <select data-export-variant>
      {% for variant in product.variants %}
        <option value="{{ variant.id }}" {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}>{{ variant.title | escape }}</option>
      {% endfor %}
    </select>
  </label>
  <label>Quantity <input data-export-quantity type="number" min="1" max="999" step="1" value="1" inputmode="numeric"></label>
  <button type="button" class="button" data-export-add disabled>Add to enquiry cart</button>
  <p role="status" data-export-status></p>
  <a href="{{ routes.cart_url }}#cellife-export-enquiry" class="link underlined-link">View enquiry cart</a>
  <noscript><p>To build an enquiry cart, enable JavaScript or <a href="{{ routes.root_url }}pages/contact">contact Cellife</a> with the products and quantities you need.</p></noscript>
  {% capture export_product_json %}{% render 'cellife-export-product-data', product: product %}{% endcapture %}
  {% capture export_script_close %}<\/{% endcapture %}
  <script type="application/json" data-export-product>{{ export_product_json | replace: '</', export_script_close }}</script>
</cellife-export-picker>
